<!doctype html>
<html lang="en">
  <%- include('./partials/head.ejs') %>
  <body>
    <%- include('./partials/nav.ejs') %>

    <div>
      <div class="container-lg my-5">
        <img src="/public/assets/user.png" class="img-fluid rounded" style="height: 5%; width: 5%">
      </div>
      <div class="container-lg my-5">
        <h2 class="display-6">Full Name</h2>
      </div>
    </div>

    <div class="container-lg my-5 bg-light">
      <div class="row">
        <div  class="col-3">
          <div>
            <ul class="list-group list-group-flush">
              <li class="list-group-item"><h3>Personal Details</h3></li>
              <li class="list-group-item">Contact and Address</li>
              <li class="list-group-item">Social Media</li>
              <li class="list-group-item">Ministries</li>
              <li class="list-group-item">Light Group</li>
            </ul>
          </div>
        </div>
        
        <div class="col-4">
          <div id="personal-details">
            <!-- Full Name -->
           <div class="container-lg my-2">
            <div class="card" style="width: 25rem;">
              <div class="card-body">
                <h6 class="card-subtitle mb-2 text-body-secondary">Full Name</h6>
                <p class="card-text">Full name</p>
              </div>
            </div>
           </div>
          <!-- Full Name -->

          <!-- Date of Birth -->
           <div class="container">
            <div class="card" style="width: 25rem;">
              <div class="card-body">
                <h6 class="card-subtitle mb-2 text-body-secondary">Date of birth</h6>
                <p class="card-text">Date of birth</p>
              </div>
            </div>
           </div>
          <!-- Date of Birth -->

          <!-- Age -->
          <div class="container-lg my-2">
            <div class="card" style="width: 25rem;">
              <div class="card-body">
                <h6 class="card-subtitle mb-2 text-body-secondary">Age</h6>
                <p class="card-text">Age</p>
              </div>
            </div>
           </div>
          <!-- Age -->
          </div>          
        </div>
        <div class="col-4">
          <div id="personal-details">
            <!-- Gender -->
            <div class="container-lg my-2">
              <div class="card" style="width: 25rem;">
                <div class="card-body">
                  <h6 class="card-subtitle mb-2 text-body-secondary">Gender</h6>
                  <p class="card-text">Gender</p>
                </div>
              </div>
            </div>
            <!-- Gender -->

            <!-- Civil Status -->
            <div class="container-lg my-2">
              <div class="card" style="width: 25rem;">
                <div class="card-body">
                  <h6 class="card-subtitle mb-2 text-body-secondary">Civil Status</h6>
                  <p class="card-text">Civil Status</p>
                </div>
              </div>
            </div>
            <!-- Civil Status -->
          </div>
        </div>
        
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>